{
  "name": "ecohuellitas-norte",
  "version": "1.0.0",
  "description": "EcoHuellitas Norte - Plataforma DevSecOps de salubridad urbana, padrón de mascotas y reporte de puntos críticos en Lima Norte",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --detectOpenHandles --forceExit",
    "lint": "eslint src/ tests/ --fix || true",
    "security:audit": "npm audit --audit-level=critical"
  },
  "keywords": [
    "salubridad",
    "lima-norte",
    "padron-mascotas",
    "devsecops",
    "ci-cd",
    "scrum",
    "jira"
  ],
  "author": "Claudia Fernanda Rejas Ruiz",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
