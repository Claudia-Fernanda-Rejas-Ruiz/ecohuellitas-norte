{
  "name": "ecohuellitas-norte",
  "version": "1.0.0",
  "description": "EcoHuellitas Norte - Plataforma DevSecOps de salubridad urbana, padrón de mascotas y reporte de puntos críticos en Lima Norte",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --detectOpenHandles --forceExit",
    "test:integration": "jest tests/integration --detectOpenHandles --forceExit",
    "lint": "eslint src/ tests/ --fix || true",
    "security:audit": "npm audit --audit-level=critical"
  },
  "keywords": [
    "salubridad",
    "lima-norte",
    "padron-mascotas",
    "devsecops",
    "ci-cd",
    "scrum",
    "jira"
  ],
  "author": "Claudia Fernanda Rejas Ruiz",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "framer-motion": "^14.14.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.76.0",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.33",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.8"
  }
}
